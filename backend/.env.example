DATABASE_URL=sqlite:///./iotivate.db
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Admin bootstrap (set all three to auto-create admin on startup)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# SMTP (contact form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USE_TLS=true
