DATABASE_URL=sqlite:///./iotivate.db
SECRET_KEY=change-me-in-production
# Comma-separated. In production include every product subdomain, e.g.
# CORS_ORIGINS=https://iotivate.dev,https://radar.iotivate.dev
# For local cross-subdomain SSO dev (see docs/LOCAL_SUBDOMAIN_DEV.md):
# CORS_ORIGINS=http://iotivate.localhost:3000,http://radar.iotivate.localhost:3001
CORS_ORIGINS=http://localhost:3000

# Refresh-cookie domain. Leave empty for local single-domain dev (host-only
# cookie). Set the parent domain so one login is shared across subdomains:
#   production:            COOKIE_DOMAIN=.iotivate.dev
#   local subdomain dev:   COOKIE_DOMAIN=iotivate.localhost
# The leading dot is optional (RFC 6265 ignores it); prod keeps it for clarity.
COOKIE_DOMAIN=

# Admin bootstrap (set all three to auto-create admin on startup)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Frontend URL (for password reset links). For local subdomain dev use
# FRONTEND_URL=http://iotivate.localhost:3000
FRONTEND_URL=http://localhost:3000

# SMTP (contact form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USE_TLS=true

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=iotivate-files
R2_PUBLIC_URL=

# Lemon Squeezy (payments)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=

# Logging
LOG_LEVEL=INFO
