# Single-domain local dev (default)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cross-subdomain SSO dev (see docs/LOCAL_SUBDOMAIN_DEV.md). The API must be
# reached on a subdomain of the cookie's parent domain so the shared refresh
# cookie is sent with credentialed requests:
# NEXT_PUBLIC_API_URL=http://api.iotivate.localhost:8000
# NEXT_PUBLIC_SITE_URL=http://iotivate.localhost:3000
