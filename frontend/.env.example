NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Meta (Facebook/Instagram) Pixel ID from Events Manager. Leave unset to disable
# the Pixel entirely (dev/local). Set in Vercel prod before running ads.
NEXT_PUBLIC_META_PIXEL_ID=
# WhatsApp number for service "Chat with us" buttons, full international format,
# digits only (e.g. 2348012345678). Leave unset to hide the WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
